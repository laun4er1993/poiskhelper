{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Основные разрешения для окна PoiskHelper",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:path:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-read-dir",
    "fs:allow-create",

    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "**/*" },
        { "path": "$HOME/**" },
        { "path": "$HOME/*" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/*" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/*" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/*" },
        { "path": "$PICTURE/**" },
        { "path": "$PICTURE/*" },
        { "path": "$VIDEO/**" },
        { "path": "$VIDEO/*" },
        { "path": "$AUDIO/**" },
        { "path": "$AUDIO/*" },
        { "path": "$TEMP/**" },
        { "path": "C:\\**" },
        { "path": "C:\\*" },
        { "path": "D:\\**" },
        { "path": "D:\\*" },
        { "path": "E:\\**" },
        { "path": "E:\\*" },
        { "path": "F:\\**" },
        { "path": "F:\\*" },
        { "path": "G:\\**" },
        { "path": "G:\\*" },
        { "path": "H:\\**" },
        { "path": "H:\\*" },
        { "path": "Z:\\**" },
        { "path": "Z:\\*" }
      ]
    }
  ]
}